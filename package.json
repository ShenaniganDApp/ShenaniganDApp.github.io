{
	"name": "shenanigan-site",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"homepage": "https://www.she.energy",
	"engines": {
		"node": ">=20.19.0 <21"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "oxlint --deny-warnings --react-plugin --vitest-plugin --jsx-a11y-plugin -A react-in-jsx-scope src e2e vite.config.js playwright.config.js",
		"test": "vitest run",
		"test:e2e": "npm run build && playwright test",
		"check": "npm run lint && npm test && npm run test:e2e"
	},
	"dependencies": {
		"react": "18.3.1",
		"react-card-flip": "1.2.3",
		"react-dom": "18.3.1",
		"react-router-dom": "5.3.4",
		"react-router-hash-link": "2.4.3",
		"react-transition-group": "4.4.5",
		"styled-components": "5.3.11"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.3",
		"@vitejs/plugin-react": "6.1.1",
		"jsdom": "29.1.1",
		"oxlint": "1.81.0",
		"vite": "8.2.2",
		"vitest": "4.1.11"
	}
}
